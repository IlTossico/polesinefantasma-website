{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hugo: server di sviluppo",
      "type": "process",
      "command": "hugo",
      "args": ["server", "-D"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "promptOnClose": false,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
